+
+  <rect fill="#FFFFFF" stroke="#1F3A5F" stroke-width="2" rx="12" x="690" y="850" width="180" height="120"/>
+  <text font-size="22" x="780" y="919">GPL</text>
+
+  <rect fill="#FFFFFF" stroke="#1F3A5F" stroke-width="2" rx="12" x="910" y="850" width="180" height="120"/>
+  <text font-size="22" x="1000" y="919">AGPL</text>
