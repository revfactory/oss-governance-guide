+  <rect fill="#FFFFFF" stroke="#1F3A5F" stroke-width="2" rx="12" x="30" y="850" width="180" height="120"/>
+  <text font-size="22" x="120" y="919">MIT</text>
+
+  <rect fill="#FFFFFF" stroke="#1F3A5F" stroke-width="2" rx="12" x="250" y="850" width="180" height="120"/>
