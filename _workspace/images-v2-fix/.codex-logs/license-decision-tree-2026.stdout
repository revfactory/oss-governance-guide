+  <path d="M 1245 565 L 1540 565 L 1540 775" fill="none" stroke="#E8A33D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" marker-end="url(#arrowAmber)"/>
+  <text font-size="20" x="1395" y="540">상용 병행</text>
